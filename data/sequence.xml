<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <record id="seq_partner" model="ir.sequence">
        <field name="name">Customer sequence</field>
        <field name="code">partner.sequence</field>
        <field name="prefix">CUS-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_supplier" model="ir.sequence">
        <field name="name">Supplier sequence</field>
        <field name="code">supplier.sequence</field>
        <field name="prefix">SUP-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
